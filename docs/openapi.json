{
  "openapi": "3.1.0",
  "info": {
    "title": "BG Tutor API",
    "description": "Local headless backgammon library and GNUbg analysis. No authentication; bind to loopback.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
