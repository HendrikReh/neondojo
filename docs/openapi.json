  },
  "components": {
    "schemas": {
      "Analysis": {
        "type": "object",
        "required": [
          "engine",
          "plies",
          "candidates"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "engine": {
            "type": "string"
          },
          "plies": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "required": [
          "rank",
          "notation",
          "equity",
          "probabilities"
        ],
        "properties": {
          "equity": {
            "type": "number",
            "format": "double"
          },
          "notation": {
            "type": "string"
          },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "Win, win gammon (including backgammon), win backgammon,\nloss, lose gammon (including backgammon), lose backgammon."
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "decision_no",
          "player",
          "kind",
          "played",
          "best",
          "equity_loss",
          "severity",
          "evaluation_status"
        ],
        "properties": {
          "best": {
            "type": "string",
            "description": "Best checker notation or cube action under the native evaluation."
          },
          "best_equity": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Best normalized cubeful equity from this player's perspective, in the same units."
          },
          "checker_no": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "One-based imported checker position; also links its preceding no-double decision.\nActual double/take/drop decisions have no checker number."
          },
          "decision_no": {
            "type": "integer",
            "format": "int32",
            "description": "One-based sequence of all checker and cube decisions within this game."
          },
          "dice": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The original imported dice for checker decisions; absent for cube decisions."
          },
          "equity_loss": {
            "type": "number",
            "format": "double",
            "description": "Nonnegative best-minus-played equity, rounded to GNUbg's six exported decimals."
          },
          "evaluation_status": {
            "type": "string",
            "description": "\"evaluated\" or \"forced\". A forced dance has null equities and zero loss;\nmissing analysis for any evaluable decision fails the game analysis."
          },
          "kind": {
            "type": "string",
            "description": "Decision kind: \"checker\" or \"cube\"."
          },
          "played": {
            "type": "string",
            "description": "Actual GNUbg checker notation, or \"no double\", \"double\", \"take\", \"drop\"."
          },
          "played_equity": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Normalized cubeful equity of the actual decision, from this player's perspective.\nCube equities use the cube value before an offer, including for its response."
          },
          "player": {
            "type": "integer",
            "format": "int32",
            "description": "Absolute color: 0 is White, 1 is Black."
          },
          "severity": {
            "type": "string",
            "description": "\"none\", \"doubtful\" (>= 0.04), \"bad\" (>= 0.08), or \"very_bad\" (>= 0.16)."
          }
        }
      },
      "DiceCount": {
        "type": "object",
        "required": [
          "dice",
          "count",
          "expected_probability"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "expected_probability": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DiceEvaluation": {
        "type": "object",
        "required": [
          "dice",
          "weight",
          "probability",
          "best"
        ],
        "properties": {
          "best": {
            "$ref": "#/components/schemas/Candidate"
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "probability": {
            "type": "number",
            "format": "double"
          },
          "weight": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DiceStats": {
        "type": "object",
        "required": [
          "total",
          "rolls"
        ],
        "properties": {
          "rolls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiceCount"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Distribution": {
        "type": "object",
        "required": [
          "engine",
          "plies",
          "mean_equity",
          "rolls"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "mean_equity": {
            "type": "number",
            "format": "double"
          },
          "plies": {
            "type": "integer",
            "format": "int32"
          },
          "rolls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiceEvaluation"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "boolean"
          },
          "gnubg": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ImportResponse": {
        "type": "object",
        "required": [
          "match",
          "duplicate"
        ],
        "properties": {
          "duplicate": {
            "type": "boolean"
          },
          "match": {
            "$ref": "#/components/schemas/MatchSummary"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "total_games",
          "completed_games",
          "kind",
          "plies",
          "status",
          "progress",
          "attempts",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "completed_games": {
            "type": "integer",
            "format": "int32"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "match_uuid": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "plies": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 0
          },
          "position_uuid": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "progress": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobResult"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_games": {
            "type": "integer",
            "format": "int32"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobEvent": {
        "type": "object",
        "required": [
          "id",
          "job_id",
          "event",
          "data",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {},
          "event": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "analysis",
          "dice",
          "match"
        ]
      },
      "JobProgress": {
        "type": "object",
        "description": "JSON encoded in the `data:` line of each job SSE message.",
        "required": [
          "status",
          "progress"
        ],
        "properties": {
          "attempt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "completed_games": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_games": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "position_id",
          "kind"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/PositionJobKind",
            "description": "analysis: five candidate moves; dice: 21 weighted rolls."
          },
          "plies": {
            "type": "integer",
            "format": "int32",
            "description": "GNUbg search depth, 0 to 2. Defaults to 0.",
            "maximum": 2,
            "minimum": 0
          },
          "position_id": {
            "type": "string",
            "format": "uuid",
            "description": "Database UUID of the imported position, not its GNUbg ID."
          }
        }
      },
      "JobResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Analysis"
          },
          {
            "$ref": "#/components/schemas/Distribution"
          },
          {
            "$ref": "#/components/schemas/MatchAnalysisSummary"
          }
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ]
      },
      "MatchAnalysisRequest": {
        "type": "object",
        "properties": {
          "plies": {
            "type": "integer",
            "format": "int32",
            "description": "Native GNUbg checker and cube search depth. Defaults to 0.",
            "maximum": 2,
            "minimum": 0
          }
        }
      },
      "MatchAnalysisSummary": {
        "type": "object",
        "required": [
          "engine",
          "plies",
          "total_games",
          "completed_games",
          "total_moves",
          "analyzed_moves",
          "players"
        ],
        "properties": {
          "analyzed_moves": {
            "type": "integer",
            "format": "int32"
          },
          "completed_games": {
            "type": "integer",
            "format": "int32"
          },
          "engine": {
            "type": "string"
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerAnalysisSummary"
            }
          },
          "plies": {
            "type": "integer",
            "format": "int32"
          },
          "total_games": {
            "type": "integer",
            "format": "int32"
          },
          "total_moves": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MatchPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "MatchSummary": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "format",
          "white",
          "black",
          "match_length",
          "position_count",
          "created_at"
        ],
        "properties": {
          "black": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "match_length": {
            "type": "integer",
            "format": "int32"
          },
          "position_count": {
            "type": "integer",
            "format": "int32"
          },
          "white": {
            "type": "string"
          }
        }
      },
      "MoveAnalysis": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Decision"
          },
          {
            "type": "object",
            "required": [
              "id",
              "game_no"
            ],
            "properties": {
              "game_no": {
                "type": "integer",
                "format": "int32"
              },
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "position_uuid": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "Imported board before this checker move; cube-only decisions have no checker board."
              }
            }
          }
        ]
      },
      "MoveAnalysisPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MoveAnalysis"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "PlayerAnalysisSummary": {
        "type": "object",
        "required": [
          "player",
          "checker_decisions",
          "cube_decisions",
          "forced_moves",
          "unavailable",
          "doubtful",
          "bad",
          "very_bad",
          "checker_equity_loss",
          "cube_equity_loss"
        ],
        "properties": {
          "bad": {
            "type": "integer",
            "format": "int32"
          },
          "checker_decisions": {
            "type": "integer",
            "format": "int32"
          },
          "checker_equity_loss": {
            "type": "number",
            "format": "double",
            "description": "Sum of normalized equity losses, not a performance rating (PR)."
          },
          "cube_decisions": {
            "type": "integer",
            "format": "int32"
          },
          "cube_equity_loss": {
            "type": "number",
            "format": "double"
          },
          "doubtful": {
            "type": "integer",
            "format": "int32"
          },
          "forced_moves": {
            "type": "integer",
            "format": "int32"
          },
          "player": {
            "type": "integer",
            "format": "int32"
          },
          "unavailable": {
            "type": "integer",
            "format": "int32"
          },
          "very_bad": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Position": {
        "type": "object",
        "required": [
          "id",
          "match_uuid",
          "ordinal",
          "game_no",
          "ply",
          "player",
          "dice",
          "board",
          "position_id",
          "gnubg_match_id",
          "notation"
        ],
        "properties": {
          "board": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "game_no": {
            "type": "integer",
            "format": "int32"
          },
          "gnubg_match_id": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "match_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "notation": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "format": "int32"
          },
          "player": {
            "type": "integer",
            "format": "int32"
          },
          "ply": {
            "type": "integer",
            "format": "int32"
          },
          "position_id": {
            "type": "string"
          }
        }
      },
      "PositionJobKind": {
        "type": "string",
        "enum": [
          "analysis",
          "dice"
        ]
      },
      "PositionPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Position"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Opaque cursor; continue with the same filters."
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "One MAT, SGF, or binary XG file, at most 16 MiB including multipart envelope."
          }
        }
      }
    }
  }
}
