    "/api/matches/{id}/source": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "source",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/x-go-sgf": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
