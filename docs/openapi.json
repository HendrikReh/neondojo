    "/api/positions": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "positions",
        "parameters": [
          {
            "name": "match_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
