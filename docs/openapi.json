{
  "openapi": "3.1.0",
  "info": {
    "title": "BG Tutor API",
    "description": "Local headless backgammon library and GNUbg analysis. No authentication; bind to loopback.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/imports": {
      "post": {
        "tags": [
          "Library"
        ],
        "operationId": "upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Previously imported file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "413": {
            "description": "Upload too large"
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "operationId": "create_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "Analysis"
        ],
        "operationId": "job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}/events": {
      "get": {
        "tags": [
          "Analysis"
        ],
        "operationId": "events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "description": "Resume after this persisted event ID",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE wire format: id: <persisted integer>\\nevent: <queued|running|progress|completed|failed>\\ndata: <JobProgress JSON>\\n\\n. Each data field conforms to components.schemas.JobProgress. Stream ends after terminal event or service shutdown; reconnect resumes via Last-Event-ID.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/matches": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "matches",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchPage"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/matches/{id}": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "get_match",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchSummary"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/matches/{id}/dice": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "dice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiceStats"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/matches/{id}/source": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "source",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/x-go-sgf": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/positions": {
      "get": {
        "tags": [
          "Library"
        ],
        "operationId": "positions",
        "parameters": [
          {
            "name": "match_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionPage"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "type": "object",
        "required": [
          "engine",
          "plies",
          "candidates"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "engine": {
            "type": "string"
          },
          "plies": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "required": [
          "rank",
          "notation",
          "equity",
          "probabilities"
        ],
        "properties": {
          "equity": {
            "type": "number",
            "format": "double"
          },
          "notation": {
            "type": "string"
          },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "Win, win gammon (including backgammon), win backgammon,\nloss, lose gammon (including backgammon), lose backgammon."
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DiceCount": {
        "type": "object",
        "required": [
          "dice",
          "count",
          "expected_probability"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "expected_probability": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DiceEvaluation": {
        "type": "object",
        "required": [
          "dice",
          "weight",
          "probability",
          "best"
        ],
        "properties": {
          "best": {
            "$ref": "#/components/schemas/Candidate"
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "probability": {
            "type": "number",
            "format": "double"
          },
          "weight": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DiceStats": {
        "type": "object",
        "required": [
          "total",
          "rolls"
        ],
        "properties": {
          "rolls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiceCount"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Distribution": {
        "type": "object",
        "required": [
          "engine",
          "plies",
          "mean_equity",
          "rolls"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "mean_equity": {
            "type": "number",
            "format": "double"
          },
          "plies": {
            "type": "integer",
            "format": "int32"
          },
          "rolls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiceEvaluation"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "boolean"
          },
          "gnubg": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ImportResponse": {
        "type": "object",
        "required": [
          "match",
          "duplicate"
        ],
        "properties": {
          "duplicate": {
            "type": "boolean"
          },
          "match": {
            "$ref": "#/components/schemas/MatchSummary"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "position_uuid",
          "kind",
          "plies",
          "status",
          "progress",
          "attempts",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "plies": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 0
          },
          "position_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "progress": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobResult"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobEvent": {
        "type": "object",
        "required": [
          "id",
          "job_id",
          "event",
          "data",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {},
          "event": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "analysis",
          "dice"
        ]
      },
      "JobProgress": {
        "type": "object",
        "description": "JSON encoded in the `data:` line of each job SSE message.",
        "required": [
          "status",
          "progress"
        ],
        "properties": {
          "attempt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "position_id",
          "kind"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/JobKind",
            "description": "analysis: five candidate moves; dice: 21 weighted rolls."
          },
          "plies": {
            "type": "integer",
            "format": "int32",
            "description": "GNUbg search depth, 0 to 2. Defaults to 0.",
            "maximum": 2,
            "minimum": 0
          },
          "position_id": {
            "type": "string",
            "format": "uuid",
            "description": "Database UUID of the imported position, not its GNUbg ID."
          }
        }
      },
      "JobResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Analysis"
          },
          {
            "$ref": "#/components/schemas/Distribution"
          }
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ]
      },
      "MatchPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "MatchSummary": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "format",
          "white",
          "black",
          "match_length",
          "position_count",
          "created_at"
        ],
        "properties": {
          "black": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "match_length": {
            "type": "integer",
            "format": "int32"
          },
          "position_count": {
            "type": "integer",
            "format": "int32"
          },
          "white": {
            "type": "string"
          }
        }
      },
      "Position": {
        "type": "object",
        "required": [
          "id",
          "match_uuid",
          "ordinal",
          "game_no",
          "ply",
          "player",
          "dice",
          "board",
          "position_id",
          "gnubg_match_id",
          "notation"
        ],
        "properties": {
          "board": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "dice": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "game_no": {
            "type": "integer",
            "format": "int32"
          },
          "gnubg_match_id": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "match_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "notation": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "format": "int32"
          },
          "player": {
            "type": "integer",
            "format": "int32"
          },
          "ply": {
            "type": "integer",
            "format": "int32"
          },
          "position_id": {
            "type": "string"
          }
        }
      },
      "PositionPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Position"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Opaque cursor; continue with the same filters."
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "One MAT, SGF, or binary XG file, at most 16 MiB including multipart envelope."
          }
        }
      }
    }
  }
}
