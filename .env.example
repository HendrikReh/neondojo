DATABASE_URL=postgres://neondojo:neondojo_local@127.0.0.1:54329/neondojo
NEONDOJO_BIND=127.0.0.1:8787
GNUBG_BIN=gnubg
# Optional: Python interpreter with the Anki package for third-party APKG imports.
# NEONDOJO_ANKI_PYTHON=/path/to/venv/bin/python
# Optional: API key if the local AnkiConnect add-on requires one.
# NEONDOJO_ANKI_CONNECT_KEY=
RUST_LOG=neondojo=info,tower_http=info
# Optional: serve the built React app from the backend.
# NEONDOJO_WEB_DIR=web/dist

# Optional AI assessment for saved point-match reports
# OPENAI_API_KEY=
# NEONDOJO_ASSESSMENT_MODEL=gpt-6.1-terra
