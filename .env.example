DATABASE_URL=postgres://bgtutor:bgtutor_local@127.0.0.1:54329/bgtutor
BGTUTOR_BIND=127.0.0.1:8787
GNUBG_BIN=gnubg
# Optional: Python interpreter with the Anki package for third-party APKG imports.
# BGTUTOR_ANKI_PYTHON=/path/to/venv/bin/python
# Optional: API key if the local AnkiConnect add-on requires one.
# BGTUTOR_ANKI_CONNECT_KEY=
RUST_LOG=bgtutor=info,tower_http=info
# Optional: serve the built React app from the backend.
# BGTUTOR_WEB_DIR=web/dist
