{
  "name": "neondojo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "cargo run -q --manifest-path ../Cargo.toml -p neondojo --example openapi > ../docs/openapi.json && openapi-typescript ../docs/openapi.json -o src/generated-api.d.ts",
    "themes:prepare": "python3 ../tools/prepare_themes.py",
    "predev": "npm run themes:prepare",
    "prebuild": "npm run themes:prepare",
    "pretest": "npm run themes:prepare",
    "test:themes": "python3 -m unittest discover -s ../tools -p 'test_*.py'"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
